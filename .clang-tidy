---
InheritParentConfig: true
Checks: [
        '*',
        -abseil-*,
        -android-*,
        -altera-*,
        -bugprone-casting-through-void,
        -bugprone-dynamic-static-initializers,
        -bugprone-easily-swappable-parameters,
        -bugprone-exception-escape,
        -bugprone-implicit-widening-of-multiplication-result,
        -bugprone-throwing-static-initialization,
        -bugprone-unchecked-string-to-number-conversion,  # todo: replace with safer conversion functions
        -boost-use-ranges,
        -cert-dcl*,
        -cert-err33-c,
        -cert-err34-c,
        -cert-err58-cpp,
        -clang-analyzer-deadcode.DeadStores,
        -cppcoreguidelines-avoid-magic-numbers,
        -cppcoreguidelines-avoid-non-const-global-variables,
        -cppcoreguidelines-macro-usage,
        -cppcoreguidelines-narrowing-conversions,  # alias for bugprone-narrowing-conversions
        -cppcoreguidelines-non-private-member-variables-in-classes,
        -cppcoreguidelines-owning-memory,
        -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
        -cppcoreguidelines-pro-bounds-constant-array-index,
        -cppcoreguidelines-pro-type-cstyle-cast,
        -cppcoreguidelines-pro-type-vararg,
        -cppcoreguidelines-use-enum-class,
        -fuchsia-*,
        -google-objc*,
        -google-readability-todo,
        -hicpp-vararg,
        -llvmlibc-*,
        -llvm-use-ranges,
        -llvm-header-guard,
        -llvm-prefer-static-over-anonymous-namespace,
        -misc-confusable-identifiers,
        -misc-no-recursion,
        -misc-non-private-member-variables-in-classes,
        -modernize-avoid-variadic-functions,
        -modernize-use-ranges, # things like sort and for_each don't support parallel execution policies yet (C++26 will?)
        -modernize-use-std-print, # replace printout macro with a function when we want to autofix to use std::format gcc >=13
        -performance-enum-size,
        -readability-identifier-length,
        -readability-function-cognitive-complexity,
        -readability-magic-numbers,
    ]
WarningsAsErrors: '*,-clang-diagnostic-unused-function'
FormatStyle: file
ExtraArgs: [-std=c++26]
# HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '^/opt/homebrew/include/.*'
CheckOptions:
    - key: bugprone-reserved-identifier.AllowedIdentifiers
      value: '__host__;__device__;__artis_assert'
    - key: bugprone-narrowing-conversions.IgnoreConversionFromTypes
      value: size_t; size_type; unsigned long
    - key: bugprone-narrowing-conversions.WarnOnEquivalentBitWidth
      value: 'false'
    - key: bugprone-narrowing-conversions.WarnOnFloatingPointNarrowingConversion
      value: 'true'
    - key: bugprone-narrowing-conversions.WarnOnIntegerToFloatingPointNarrowingConversion
      value: 'false'
    - key: cppcoreguidelines-init-variables.IncludeStyle
      value: google
    - key: cppcoreguidelines-init-variables.MathHeader
      value: <cmath>
    - key: hicpp-signed-bitwise.IgnorePositiveIntegerLiterals
      value: 'true'
    - key: modernize-deprecated-headers.CheckHeaderFile
      value: 'true'
    - key: modernize-use-std-print.PrintfLikeFunctions
      value: printf; absl::PrintF; printout
    - key: modernize-use-std-print.FprintfLikeFunctions
      value: fprintf; absl::FPrintF
    - key: readability-identifier-naming.NamespaceCase
      value: lower_case
    - key: modernize-use-trailing-return-type.TransformLambdas
      value: 'none'
