CompileFlags:
    # to make the compilation database, run:
    # make TESTMODE=ON compile_commands.json
    CompilationDatabase: compile_commands.json
    # the database carries the flags of the build, so add only what it cannot give:
    # the language of a header, and a warning that the build permits
    Add: [-xc++, -Wno-unused-const-variable, -std=c++26, -DTESTMODE=true, -Wall, -Wextra, -Wpedantic, -Wredundant-decls, -Wno-unneeded-internal-declaration, -Wno-unused-parameter, -Wno-unused-const-variable, -Wsign-compare, -Wshadow, -isystem, third_party/]

Diagnostics:
    ClangTidy:
        FastCheckFilter: None
    UnusedIncludes: Strict
    MissingIncludes: Strict
    Includes:
        AnalyzeAngledIncludes: true
        IgnoreHeader: "(sys/_types/_pid_t.h|signal.h)"

Completion:
    AllScopes: true

InlayHints:
    BlockEnd: true
    Designators: true
    Enabled: true
    ParameterNames: true
    DeducedTypes: false

Hover:
  ShowAKA: Yes
