{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["dependencies"],
  "bumpVersion": "major",
  "pre-commit": {
    "automerge": true,
    "enabled": true
  },
  "rebaseWhen": "conflicted",
  "schedule": [
    "* 9-15 * * 2"
  ]
}
