{
    "configurations": [
        {
            "name": "Debug the unit tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/unittests",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_stack_use_after_return=1:detect_leaks=0"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "make unittests"
        }
    ],
    "version": "2.0.0"
}
